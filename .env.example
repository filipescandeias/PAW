# Copia este ficheiro para .env e preenche com os teus valores

# Opção 1: URL completo da base de dados (ex.: Render)
DATABASE_URL=

# Opção 2: ligação por campos (usado se DATABASE_URL estiver vazio)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_DATABASE=

# Supabase (armazenamento de ficheiros)
SUPABASE_URL=
SUPABASE_KEY=
